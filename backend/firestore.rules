rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function space(s) { return get(/databases/$(database)/documents/spaces/$(s)).data; }
    function membership() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
    function principal(s) { return membership().get('canonicalUid', request.auth.uid); }
    function membershipValid(s, m, team, uid) {
      return signedIn() && m.spaceId == s
        && (uid == request.auth.uid || m.get('expiresAt', null) is timestamp)
        && request.time < m.get('expiresAt',request.time + duration.value(1,'h')) && uid in team.uids;
    }
    function member(s) {
      let m = membership();
      return membershipValid(s,m,space(s),m.get('canonicalUid',request.auth.uid));
    }
    function role(s) { return space(s).roles[principal(s)]; }
    function owned(s, d) { return d.owner == principal(s) && d.data.owner == role(s); }
    function readable(s, d) {
      let m = membership();
      let uid = m.get('canonicalUid',request.auth.uid);
      return uid in d.readers && membershipValid(s,m,space(s),uid);
    }
    function readersValid(team, d) {
      return d.readers == (d.shared ? team.uids : [d.owner]);
    }
    function dataValid(team, d) {
      return d.keys().hasOnly(['type','owner','readers','shared','data','deleted','revision','updatedAt','actor'])
        && d.type in ['entry','plan'] && d.owner in team.uids
        && d.deleted is bool && d.shared is bool && d.data is map
        && d.revision is string && d.revision.size() > 10 && d.revision.size() < 80
        && d.actor == request.auth.uid && d.updatedAt == request.time
        && d.data.owner == team.roles[d.owner] && readersValid(team, d)
        && (d.type == 'entry' ? entryValid(d) : collectionValid(d));
    }
    function entryValid(d) {
      let e = d.data;
      return e.keys().hasOnly(['id','title','date','week','lastDate','start','end','kind','who','owner','visibility','editable','done','note','invite','incoming','resolvedDay','isGathering','proposal','proposalResponseId','titleFormat','descriptionFormat'])
        && e.get('titleFormat','plain-v1') in ['plain-v1','markdown-v1'] && e.get('descriptionFormat','plain-v1') in ['plain-v1','markdown-v1']
        && e.title is string && e.title.size() <= 100 && e.note is string && e.note.size() <= 10000
        && e.kind in ['TASK','EVENT'] && e.who in ['USER_1','USER_2','BOTH']
        && e.visibility in ['SHARED','PRIVATE','BUSY'] && e.editable is bool && e.done is bool
        && e.invite in ['NONE','PENDING','ACCEPTED','DECLINED'] && e.isGathering is bool
        && e.date is string && e.week is string && e.lastDate is string && e.start is string && e.end is string
        && e.resolvedDay is string && e.incoming is bool && d.shared == (e.visibility == 'SHARED')
        && e.get('proposalResponseId','') is string && e.get('proposalResponseId','').size() <= 128
        && (e.get('proposal',null) == null || (e.invite in ['PENDING','ACCEPTED'] && proposalValid(e.proposal,e)))
        && (e.invite == 'NONE' || (d.shared && e.who == 'BOTH'))
        && (!e.isGathering || (e.kind == 'EVENT' && e.who == 'BOTH' && d.shared && e.invite != 'NONE'
          && e.date.size() == 10 && e.lastDate == e.date && e.start.matches('[0-2][0-9]:[0-5][0-9]') && e.end > e.start));
    }
    function collectionValid(d) {
      return d.data.keys().hasOnly(['id','name','shared','owner','updatedAt','items','itemIds'])
        && d.data.name is string && d.data.name.size() <= 2000 && d.data.items is list && d.data.items.size() <= 500
        && d.data.shared == d.shared && (d.type != 'plan' || d.shared);
    }
    function proposalValid(p, e) {
      return p is map && p.keys().hasOnly(['id','proposedBy','title','date','lastDate','start','end','note','titleFormat','descriptionFormat'])
        && p.get('titleFormat','plain-v1') in ['plain-v1','markdown-v1'] && p.get('descriptionFormat','plain-v1') in ['plain-v1','markdown-v1']
        && p.id is string && p.id.size() > 0 && p.id.size() <= 128 && p.id.matches('[^/]+')
        && p.proposedBy in ['USER_1','USER_2'] && p.title is string && p.title.size() > 0 && p.title.size() <= 100
        && p.note is string && p.note.size() <= 10000
        && p.date is string && p.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && p.lastDate is string && p.lastDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && p.lastDate >= p.date
        && p.start is string && p.start.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && p.end is string && p.end.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && (p.lastDate > p.date || p.end > p.start) && (!e.isGathering || p.lastDate == p.date);
    }
    function proposalAnswer(actorRole, p, before, after, changed) {
      return p.proposedBy != actorRole && after.get('proposalResponseId','') == p.id
        && (changed.hasOnly(['proposal','proposalResponseId'])
          || (after.invite == 'ACCEPTED'
            && changed.hasOnly(['proposal','proposalResponseId','title','date','lastDate','week','start','end','note','invite','resolvedDay','titleFormat','descriptionFormat'])
            && after.title == p.title && after.date == p.date && after.lastDate == p.lastDate
            && after.start == p.start && after.end == p.end && after.note == p.note
            && after.get('titleFormat','plain-v1') == p.get('titleFormat','plain-v1')
            && after.get('descriptionFormat','plain-v1') == p.get('descriptionFormat','plain-v1')
            && after.week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && after.week <= after.date));
    }
    function invitationUpdate(actorRole, isOwner, old, next) {
      let before = old.data;
      let after = next.data;
      let p = after.get('proposal',null);
      let prior = before.get('proposal',null);
      let changed = after.diff(before).affectedKeys();
      return old.shared && before.who == 'BOTH' && !old.deleted && !next.deleted
        && before.invite in ['PENDING','ACCEPTED']
        && (p != null
          ? (p.proposedBy == actorRole && (prior == null || p.id != prior.id)
            && after.get('proposalResponseId','') == '' && changed.hasOnly(['proposal','proposalResponseId']))
          : (prior != null
            ? proposalAnswer(actorRole,prior,before,after,changed)
            : (!isOwner && before.invite == 'PENDING' && after.invite in ['ACCEPTED','DECLINED']
              && after.get('proposalResponseId','') == before.get('proposalResponseId','')
              && changed.hasOnly(['invite','resolvedDay']))));
    }
    function entryUpdate(actorRole, isOwner, old, next) {
      return next.data.visibility == old.data.visibility
        && (isOwner || next.data.editable == old.data.editable)
        && (old.data.invite == 'NONE'
          ? (next.data.invite == 'NONE' && (isOwner || (old.shared && old.data.editable)))
          : ((isOwner && (next.deleted || old.deleted) && next.data == old.data)
            || invitationUpdate(actorRole,isOwner,old,next)));
    }
    function allowedUpdate(uid, actorRole, old, next) {
      let isOwner = old.owner == uid;
      return next.type == old.type && next.owner == old.owner && next.data.id == old.data.id
        && (next.deleted == old.deleted || isOwner)
        && next.readers == old.readers && next.shared == old.shared && next.data.owner == old.data.owner
        && (old.type == 'entry' ? entryUpdate(actorRole,isOwner,old,next) : (isOwner || old.shared));
    }
    function recordCreate(s, id, next) {
      let m = membership();
      let uid = m.get('canonicalUid',request.auth.uid);
      let team = space(s);
      return membershipValid(s,m,team,uid) && next.owner == uid && next.data.owner == team.roles[uid]
        && !next.deleted && dataValid(team,next)
        && (next.type != 'entry' || (next.data.invite in ['NONE','PENDING']
          && next.data.get('proposal',null) == null && next.data.get('proposalResponseId','') == ''))
        && historyMatches(s,id,next) && busyMatches(s,id,next);
    }
    function recordUpdate(s, id, old, next) {
      let m = membership();
      let uid = m.get('canonicalUid',request.auth.uid);
      let team = space(s);
      return uid in old.readers && membershipValid(s,m,team,uid) && next.revision != old.revision
        && allowedUpdate(uid,team.roles[uid],old,next) && dataValid(team,next)
        && historyMatches(s,id,next) && busyMatches(s,id,next);
    }
    function historyMatches(s, id, d) {
      return getAfter(/databases/$(database)/documents/spaces/$(s)/records/$(id)/revisions/$(d.revision)).data == d;
    }
    function busyProjection(d) {
      return (!d.deleted && d.data.visibility == 'BUSY') ? {'owner':d.owner,'revision':d.revision,'active':true,
        'date':d.data.date,'lastDate':d.data.lastDate,'week':d.data.week,'start':d.data.start,'end':d.data.end,
        'who':d.data.who,'kind':d.data.kind} : {'owner':d.owner,'revision':d.revision,'active':false};
    }
    function busyMatches(s, id, d) {
      return d.type != 'entry' || getAfter(/databases/$(database)/documents/spaces/$(s)/busy/$(id)).data == busyProjection(d);
    }
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /spaces/{s} {
      allow get: if member(s);
      allow list, create, delete: if false;
      allow update: if member(s) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([role(s)])
        && request.resource.data.names[role(s)] is string
        && request.resource.data.names[role(s)].size() > 0 && request.resource.data.names[role(s)].size() <= 40;
      function noteGroupValid(d, id) {
        return d.keys().hasOnly(['id','name','shared','owner','editable','archived','updatedAt'])
          && d.id == id && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.shared == true && d.owner in ['USER_1','USER_2'] && d.editable is bool
          && d.archived is bool && d.updatedAt is int;
      }
      function groupForNote(d) { return getAfter(/databases/$(database)/documents/spaces/$(s)/noteGroups/$(d.groupId)).data; }
      function noteValid(d, id) {
        return d.keys().hasOnly(['id','groupId','title','blocks','archived','updatedAt','revision','textFormat','titleFormat','markdown'])
          && d.id == id && d.groupId is string && d.title is string && d.title.size() <= 200
          && d.get('textFormat','plain-v1') in ['plain-v1','markdown-v1'] && d.get('titleFormat','plain-v1') in ['plain-v1','markdown-v1']
          && d.get('markdown','') is string && d.get('markdown','').size() <= 150000
          && d.blocks is list && d.blocks.size() <= 200 && d.archived is bool && d.updatedAt is int
          && d.revision is string && d.revision.size() > 10 && d.revision.size() <= 80
          && groupForNote(d).shared == true;
      }
      function canEditNotes(d) { let g=groupForNote(d); return g.owner == role(s) || g.editable; }
      match /noteGroups/{id} {
        allow read: if member(s);
        allow create: if member(s) && noteGroupValid(request.resource.data,id) && request.resource.data.owner == role(s);
        allow update: if member(s) && noteGroupValid(request.resource.data,id)
          && request.resource.data.owner == resource.data.owner && request.resource.data.shared == resource.data.shared
          && (resource.data.owner == role(s) || (resource.data.editable && request.resource.data.editable == resource.data.editable));
        allow delete: if false;
      }
      match /notes/{id} {
        allow read: if member(s);
        allow create: if member(s) && noteValid(request.resource.data,id)
          && !exists(/databases/$(database)/documents/spaces/$(s)/retiredNotes/$(id))
          && !groupForNote(request.resource.data).archived;
        allow update: if member(s) && noteValid(request.resource.data,id)
          && (canEditNotes(resource.data) || (request.resource.data.groupId != resource.data.groupId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId','revision','updatedAt'])))
          && (request.resource.data.groupId == resource.data.groupId || !groupForNote(request.resource.data).archived);
        // Retirement stores only an ID, never text/history. It blocks stale offline clients from resurrecting a moved note.
        allow delete: if member(s) && getAfter(/databases/$(database)/documents/spaces/$(s)/retiredNotes/$(id)).data.retired == true;
      }
      match /retiredNotes/{id} {
        allow read: if member(s);
        allow create: if member(s) && request.resource.data.keys().hasOnly(['retired']) && request.resource.data.retired == true
          && exists(/databases/$(database)/documents/spaces/$(s)/notes/$(id))
          && !existsAfter(/databases/$(database)/documents/spaces/$(s)/notes/$(id));
        allow update, delete: if false;
      }
      match /records/{id} {
        allow read: if readable(s, resource.data);
        allow create: if recordCreate(s,id,request.resource.data);
        allow update: if recordUpdate(s,id,resource.data,request.resource.data);
        allow delete: if false;
        match /revisions/{revision} {
          allow read: if readable(s, get(/databases/$(database)/documents/spaces/$(s)/records/$(id)).data)
            && principal(s) in resource.data.readers;
          allow create: if member(s) && request.resource.data.revision == revision
            && getAfter(/databases/$(database)/documents/spaces/$(s)/records/$(id)).data == request.resource.data;
          allow update, delete: if false;
        }
      }
      function activePlanChat(chat) {
        let parent = get(/databases/$(database)/documents/spaces/$(s)/records/$('plan_' + chat.collectionId)).data;
        return parent.type == 'plan' && parent.shared && !parent.deleted && principal(s) in parent.readers
          && chat.itemId in parent.data.get('itemIds',[]);
      }
      function activeEntryChat(chat) {
        let parent = get(/databases/$(database)/documents/spaces/$(s)/records/$('entry_' + chat.itemId)).data;
        return parent.type == 'entry' && parent.data.id == chat.itemId && parent.shared && !parent.deleted
          && parent.data.visibility == 'SHARED' && principal(s) in parent.readers;
      }
      function chatAvailable(chatId, chat) {
        return (chatId == 'general' && chat.type == 'general' && chat.collectionId == '' && chat.itemId == '')
          || (chat.type == 'plan' && chat.collectionId is string && chat.itemId is string
            && chatId == 'plan_' + chat.collectionId + '_' + chat.itemId && activePlanChat(chat))
          || (chat.type == 'entry' && chat.collectionId == '' && chat.itemId is string
            && chatId == 'entry_' + chat.itemId && activeEntryChat(chat));
      }
      function activeChat(chatId) {
        return chatAvailable(chatId,get(/databases/$(database)/documents/spaces/$(s)/chats/$(chatId)).data);
      }
      match /chats/{chatId} {
        // A missing metadata document may be checked before its guarded creation transaction.
        allow get: if member(s) && (!exists(/databases/$(database)/documents/spaces/$(s)/chats/$(chatId)) || chatAvailable(chatId,resource.data));
        allow list: if false;
        allow create: if member(s) && request.resource.data.keys().hasOnly(['type','collectionId','itemId','createdBy','createdAt'])
          && request.resource.data.createdBy == principal(s) && request.resource.data.createdAt == request.time
          && chatAvailable(chatId,request.resource.data);
        allow update, delete: if false;
        match /messages/{messageId} {
          function formatValid(d) { return d.get('format','plain-v1') in ['plain-v1','markdown-v1']; }
          function replyValid(d) {
            return d.get('replyTo','') == '' || (d.replyTo is string && d.replyTo.size() <= 200
              && get(/databases/$(database)/documents/spaces/$(s)/chats/$(chatId)/messages/$(d.replyTo)).data.deleted == false);
          }
          function messageActive() {
            return get(/databases/$(database)/documents/spaces/$(s)/chats/$(chatId)/messages/$(messageId)).data.deleted == false;
          }
          allow read: if member(s) && activeChat(chatId);
          allow create: if member(s) && activeChat(chatId)
            && request.resource.data.keys().hasOnly(['sender','actor','role','text','createdAt','clientTime','deleted','format','replyTo','attachmentIds'])
            && request.resource.data.sender == principal(s) && request.resource.data.actor == request.auth.uid
            && request.resource.data.role == role(s) && request.resource.data.createdAt == request.time
            && request.resource.data.clientTime is int && request.resource.data.deleted == false
            && request.resource.data.get('attachmentIds',[]) == []
            && formatValid(request.resource.data) && replyValid(request.resource.data)
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;
          allow update: if member(s) && activeChat(chatId) && resource.data.sender == principal(s)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','deleted','format','editedAt'])
            && !resource.data.deleted && request.resource.data.text is string && formatValid(request.resource.data)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt']) || request.resource.data.editedAt == request.time)
            && ((request.resource.data.deleted == true && request.resource.data.text == '')
              || (request.resource.data.deleted == false && (request.resource.data.text.size() > 0 || resource.data.get('attachmentIds',[]).size() > 0) && request.resource.data.text.size() <= 4000));
          allow delete: if false;
          match /reads/{uid} {
            allow read: if member(s) && activeChat(chatId) && messageActive();
            allow create, update: if member(s) && activeChat(chatId) && messageActive() && uid == principal(s)
              && request.resource.data.keys().hasOnly(['readAt','actor'])
              && request.resource.data.actor == request.auth.uid && request.resource.data.readAt == request.time;
            allow delete: if false;
          }
          match /reactions/{uid} {
            allow read: if member(s) && activeChat(chatId) && messageActive();
            allow create, update: if member(s) && activeChat(chatId) && messageActive() && uid == principal(s)
              && request.resource.data.keys().hasOnly(['emoji','updatedAt','actor']) && request.resource.data.actor == request.auth.uid
              && request.resource.data.updatedAt == request.time && request.resource.data.emoji in ['💜','👍','🐾','😊'];
            allow delete: if member(s) && activeChat(chatId) && uid == principal(s);
          }
        }
      }
      match /attachments/{id} {
        allow read: if member(s) && activeChat(resource.data.chatId)
          && ((resource.data.state == 'pending' && resource.data.owner == principal(s))
            || (resource.data.state in ['ready','expired'] && get(/databases/$(database)/documents/spaces/$(s)/chats/$(resource.data.chatId)/messages/$(resource.data.messageId)).data.deleted == false));
        allow write: if false;
      }
      match /notifications/{uid}/items/{eventId} {
        // History is neutral metadata; opening the target performs its current privacy check.
        allow read: if member(s) && uid == principal(s);
        allow update: if member(s) && uid == principal(s)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true;
        allow create, delete: if false;
      }
      match /members/{uid}/seenEntries/{entryId} {
        allow read: if member(s) && uid == principal(s);
        allow create, update: if member(s) && uid == principal(s)
          && request.resource.data.keys().hasOnly(['seenAt','actor'])
          && request.resource.data.seenAt == request.time && request.resource.data.actor == request.auth.uid
          && readable(s,get(/databases/$(database)/documents/spaces/$(s)/records/$('entry_' + entryId)).data);
        allow delete: if false;
      }
      match /devices/{id} {
        allow read: if member(s) && resource.data.authUid == request.auth.uid;
        allow delete: if member(s) && id.matches(request.auth.uid + '_[a-zA-Z0-9-]{10,80}')
          && (!exists(/databases/$(database)/documents/spaces/$(s)/devices/$(id))
            || resource.data.authUid == request.auth.uid);
        allow create, update: if member(s)
          && id.matches(request.auth.uid + '_[a-zA-Z0-9-]{10,80}')
          && request.resource.data.keys().hasOnly(['authUid','canonicalUid','token','updatedAt'])
          && request.resource.data.authUid == request.auth.uid && request.resource.data.canonicalUid == principal(s)
          && request.resource.data.token is string && request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 4096
          && request.resource.data.updatedAt == request.time;
      }
      match /pushQueue/{id} {
        allow create: if member(s)
          && request.resource.data.keys().hasOnly(['kind','recordId','revision','chatId','messageId','actor','createdAt'])
          && request.resource.data.actor == request.auth.uid && request.resource.data.createdAt == request.time
          && ((request.resource.data.kind == 'record' && request.resource.data.chatId == '' && request.resource.data.messageId == ''
            && id == request.resource.data.revision
            && (!exists(/databases/$(database)/documents/spaces/$(s)/records/$(request.resource.data.recordId))
              || get(/databases/$(database)/documents/spaces/$(s)/records/$(request.resource.data.recordId)).data.revision != request.resource.data.revision)
            && getAfter(/databases/$(database)/documents/spaces/$(s)/records/$(request.resource.data.recordId)).data.revision == request.resource.data.revision
            && getAfter(/databases/$(database)/documents/spaces/$(s)/records/$(request.resource.data.recordId)).data.actor == request.auth.uid
            && getAfter(/databases/$(database)/documents/spaces/$(s)/records/$(request.resource.data.recordId)).data.updatedAt == request.time)
          || (request.resource.data.kind == 'chat' && request.resource.data.recordId == '' && request.resource.data.revision == ''
            && id == request.resource.data.messageId && activeChat(request.resource.data.chatId)
            && !exists(/databases/$(database)/documents/spaces/$(s)/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId))
            && getAfter(/databases/$(database)/documents/spaces/$(s)/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)).data.actor == request.auth.uid
            && getAfter(/databases/$(database)/documents/spaces/$(s)/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)).data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/spaces/$(s)/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)).data.deleted == false));
        allow read, update, delete: if false;
      }
      match /busy/{id} {
        allow read: if member(s) && (resource.data.active || resource.data.owner == principal(s));
        function matchesRecord() {
          let parent = getAfter(/databases/$(database)/documents/spaces/$(s)/records/$(id)).data;
          return request.resource.data == busyProjection(parent) && parent.actor == request.auth.uid && parent.updatedAt == request.time;
        }
        allow create, update: if member(s) && matchesRecord();
        allow delete: if false;
      }
    }
  }
}
